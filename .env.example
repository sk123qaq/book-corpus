# 复制到仓库根：cp .env.example .env
# 真实环境变量优先；这里的值只在没导出时生效（os.environ.setdefault）。
# 改了 .env 要重启对应服务才读得到：8771 四读、8773 首页。

# ---- 四读：标注 / 结构 / 深读 ----
# 不填时用 pi 里已登录的 opencode-go（~/.pi/agent/auth.json）
# OPENCODE_GO_API_KEY=
# READING_MODEL_URL=
# READING_MODEL_NAME=deepseek-v4.1-flash
# READING_MODEL_EFFORT=high
# READING_MODEL_TIMEOUT=300
# READING_MODEL_MAX_TOKENS=16000

# ---- 四读：研究层与引用层 ----
# auto 会按 tavily → brave → serper → firecrawl 挑第一个有 key 的
READING_SEARCH_PROVIDER=auto
FIRECRAWL_API_KEY=
# TAVILY_API_KEY=
# BRAVE_API_KEY=
# SERPER_API_KEY=

# 自定义检索端点（READING_SEARCH_PROVIDER=http 时用）
# READING_SEARCH_ENDPOINT=
# READING_SEARCH_API_KEY=

# 抓页：http 是内置抓取、不需要 key；要更强的正文提取就改 firecrawl
READING_FETCH_PROVIDER=http

# ---- 四读开关 ----
# READING_ANNOTATE=0     关掉标注模型（离线确定性草稿，仅测试用）
# READING_EDITORIAL=0    关掉编辑层（图版与旁批）
# READING_DEPTH=0        关掉深读模式

# ---- 工作区根 ----
# 有 books.toml 的那层。`book-corpus init <目录>` 建完工作区会把这一行写进 .env，
# 之后同仓的命令不必再带 --root。优先级：--root > shell 里 export 的 BOOKS_ROOT > 这里。
# BOOKS_ROOT=/home/you/书库

# ---- OCR / 扩展生成 ----
# 也认老位置：~/.config/mineru/api_key、~/.config/PaddleOCR/api_key、~/.config/mimo/api_key
# MINERU_API_KEY=
